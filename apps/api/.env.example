# Copie para .env e ajuste. Nunca versione o .env.
PORTA=3333
AMBIENTE=desenvolvimento
# Origens que o app web pode usar (separadas por vírgula). Vazio = nenhuma.
CORS_ORIGENS=
# Usuário da API (membro do papel app_api, sem BYPASSRLS). Obrigatória em produção.
DATABASE_URL=
# Usuário dono do esquema, só para npm run migrar / npm run semear.
DATABASE_URL_MIGRACAO=
# Chaves de dados pessoais (base64, 32 bytes). A de maior id cifra; as outras só decifram.
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVES_CIFRA=
CHAVE_INDICE=
# E-mail do código de acesso: dev (escreve no log) ou resend. Em produção, só resend.
EMAIL_PROVEDOR=dev
RESEND_API_KEY=
EMAIL_REMETENTE=Acessa Evento <acesso@seu-dominio.com.br>

# Monitoramento de erros (opcional). Sem DSN, erros ficam só no log. Nunca leva dados pessoais.
# SENTRY_DSN=https://<chave>@<host>/<projeto>

# Chave Ed25519 que assina o QR dos ingressos (obrigatória em produção).
# Gere com: node -e "console.log(require('node:crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
# QR_CHAVE_PRIVADA=
# QR_CHAVE_ID=qr-2026
