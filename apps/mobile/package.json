  "main": "expo-router/entry",
  "dependencies": {
    "@acessa-evento/tokens": "0.1.0",
    "@expo/metro-runtime": "58.0.17",
    "@noble/curves": "1.9.7",
    "expo": "~58.0.23",
    "expo-brightness": "58.0.2",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "~58.0.4",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --ci",
    "medir": "jest src/testes/medicao.test.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}"
    ]
  },
