{
  "expo": {
    "name": "Acessa Evento",
    "slug": "acessa-evento",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.ccpnexatech.acessaevento"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.ccpnexatech.acessaevento"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "acessaevento",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "A equipe de credenciamento usa a câmera para ler o QR dos ingressos na entrada.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
