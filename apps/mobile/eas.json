{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_EVENTO": "simulacao-2026" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_EVENTO": "cocal-2026" }
    }
  }
}
